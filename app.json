{
  "expo": {
    "name": "Opsflare",
    "slug": "opsflare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cfops",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cloudflareops.app",
      "appleTeamId": "R24C9LCV3S",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cloudflareops.app",
      "adaptiveIcon": {
        "backgroundColor": "#1d2128",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Opsflare to use Face ID to unlock your local app account."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1d2128",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "cloudflareOauth": {
        "clientId": "d3bc3dfca1276d0d5ed8f2a6fb148473",
        "redirectUri": "https://cfops-oauth-relay.aiall.workers.dev/callback",
        "scopes": []
      },
      "router": {},
      "eas": {
        "projectId": "1e04d0bf-490e-4841-a4d7-0d7974ed33bc"
      }
    },
    "owner": "jackmatt"
  }
}
